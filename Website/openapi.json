    },
    "/v1/profiles/{profileId}": {
      "get": {
        "operationId": "getThumbleProfile",
        "summary": "Read the latest saved controller revision for this account.",
        "description": "Read the latest saved controller revision for this account.",
        "security": [
          {
            "OAuth2": [
              "profiles:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "description": "Requested profileId.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileRevision"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid bearer token.",
            "content": {
