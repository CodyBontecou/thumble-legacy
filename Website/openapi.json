                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profiles/{profileId}/revisions/{revision}": {
      "get": {
        "operationId": "getThumbleProfileRevision",
        "summary": "Read an immutable saved controller revision for this account.",
        "description": "Read an immutable saved controller revision for this account.",
        "security": [
          {
            "OAuth2": [
              "profiles:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "description": "Requested profileId.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "path",
            "required": true,
            "description": "Requested revision.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileRevision"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Required read scope is absent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Record or route not found for this account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/deliveries/{deliveryId}": {
      "get": {
        "operationId": "getThumbleDelivery",
        "summary": "Read an existing delivery receipt. Queued does not mean displayed or tested in WoW.",
        "description": "Read an existing delivery receipt. Queued does not mean displayed or tested in WoW.",
        "security": [
          {
            "OAuth2": [
              "deliveries:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "deliveryId",
            "in": "path",
            "required": true,
            "description": "Requested deliveryId.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "delivery": {
                      "$ref": "#/components/schemas/Delivery"
                    }
                  },
                  "required": [
                    "delivery"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Required read scope is absent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Record or route not found for this account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Configuration": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "integer",
            "const": 1
          },
          "auth": {
            "type": "object",
            "properties": {
              "issuer": {
                "type": "string"
              },
              "authorizationEndpoint": {
                "type": "string"
              },
              "tokenEndpoint": {
                "type": "string"
              },
              "mobileClientId": {
                "type": "string"
              },
              "audience": {
                "type": "string"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "issuer",
              "authorizationEndpoint",
              "tokenEndpoint",
              "mobileClientId",
              "audience",
              "scopes"
            ]
          },
          "mcpUrl": {
            "type": "string"
          }
        },
        "required": [
          "apiVersion",
          "auth",
          "mcpUrl"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          },
          "viewport": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "required": [
              "width",
              "height"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "platform",
          "viewport"
        ]
      },
      "ProfileSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "revision",
          "updatedAt"
        ]
      },
      "ProfileRevision": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "object",
            "description": "Declarative controller data; use the authenticated MCP profile_schema tool for its full layout schema.",
            "additionalProperties": true
          },
          "revision": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "profile",
          "revision",
          "createdAt"
        ]
      },
      "Delivery": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          },
          "profileId": {
            "type": "string"
          },
          "profileRevision": {
            "type": "integer"
          },
          "requestId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "received",
              "rendered",
              "rejected",
              "superseded"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "deviceId",
          "profileId",
          "profileRevision",
          "state"
        ]
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "description": "Registered client, authorization code flow, PKCE S256 and explicit user consent. Issuer: https://thumble.io/api/auth.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://thumble.io/api/auth/oauth2/authorize",
            "tokenUrl": "https://thumble.io/api/auth/oauth2/token",
            "scopes": {
              "profiles:read": "Read saved controllers",
              "devices:read": "Read registered phones",
              "deliveries:read": "Read delivery receipts"
            }
          }
        }
      }
    }
  }
}
