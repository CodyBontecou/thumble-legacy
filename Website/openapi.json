{
  "openapi": "3.1.0",
  "info": {
    "title": "Thumble read API",
    "version": "1.0.0",
    "description": "Public discovery and authenticated account-read subset for Thumble phone gamepad controllers. Generation and writes are disabled on the hosted agent integration. Native device management is outside this contract."
  },
  "servers": [
    {
      "url": "https://thumble.io"
    }
  ],
  "externalDocs": {
    "url": "https://thumble.io/developers"
  },
  "paths": {
    "/v1/config": {
      "get": {
        "operationId": "getThumbleConfiguration",
        "summary": "Read public OAuth endpoints and MCP configuration without credentials.",
        "description": "Read public OAuth endpoints and MCP configuration without credentials.",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Configuration"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Required read scope is absent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Record or route not found for this account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
