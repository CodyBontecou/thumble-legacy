  "nativeImplementationContract": {
    "appearance": "Use native scheme-aware light/dark fills and contrasting native foregrounds; no appearance bank, new portrait-bank API, appearance package, or canonical artboard required.",
    "pressed": "Native scheme-aware press fill derives from ordinary native fill; exact advisory palette tokens may be adapted. Keep stable geometry and caption baselines.",
    "disabled": "Overall native opacity0.8; neutral#737873 border; raised shadow off. Remeasure actual composited key-hint glyph interiors against faces and require4.5:1.",
    "activeTrackedMinor": "Native active currently inherits pressed face with stronger continuous border. Distinguishable in review1, but ordinary active face remains tracked minor2; no blanket redesign authorized.",
    "defaultCaptionRefresh": "Known captions Up,Back,Target,Previous retain full imported accessibility names. Both raw imported labels and legacy normalized12-character labels are unchanged imported defaults eligible for default-caption correction; manual labels are preserved.",
    "portraitRecovery": "For<=16 supported commands use y700; for dense17\u201324 commands retain y662 and positions632\u2013692 to leave footer room. Never reposition on ordinary refresh.",
    "outputs": "Imported UUIDs, resolved outputs and modifiers, and refresh/manual-edit preservation remain unchanged."
  }
