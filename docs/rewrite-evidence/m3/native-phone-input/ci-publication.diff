+fn decode_hex<const N: usize>(value: &Value) -> [u8; N] {
+    let text = value.as_str().unwrap();
+    assert_eq!(text.len(), N * 2);
+    let mut out = [0; N];
+    for (i, byte) in out.iter_mut().enumerate() {
+        *byte = u8::from_str_radix(&text[i * 2..i * 2 + 2], 16).unwrap();
+    }
+    out
